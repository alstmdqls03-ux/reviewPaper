# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Real LLM answers need this. Leave MOCK_LLM=1 to run fully offline (canned responses).
ANTHROPIC_API_KEY=sk-ant-...
MOCK_LLM=0

# Signs cross-device account restore tokens. MUST be a long random string in prod —
# the default is public and lets anyone forge any account's token.
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=change-me-to-a-long-random-string

# Gate /analytics behind this. Empty => analytics is open (dev only).
ADMIN_TOKEN=

# Optional tuning (defaults shown).
# MODEL=claude-opus-4-8
# RATE_LIMIT=30
# RATE_WINDOW=60
# MAX_UPLOAD_MB=50
